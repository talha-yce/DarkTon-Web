@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile Page";
}
<!DOCTYPE html>
<html lang="zxx">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="Anime Template">
    <meta name="keywords" content="Anime, unica, creative, html">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Profil Sayfası</title>

    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="css/elegant-icons.css" type="text/css">
    <link rel="stylesheet" href="css/plyr.css" type="text/css">
    <link rel="stylesheet" href="css/nice-select.css" type="text/css">
    <link rel="stylesheet" href="css/owl.carousel.min.css" type="text/css">
    <link rel="stylesheet" href="css/slicknav.min.css" type="text/css">
    <link rel="stylesheet" href="css/style.css" type="text/css">
     <style>
        /* Özel CSS Buraya */
        .profile__details {
            padding-left: 20px;
        }

        .profile__details h2 {
            font-family: 'Oswald', sans-serif;
            font-size: 28px;
            color: #333;
            margin-bottom: 10px;
            border-bottom: 2px solid #333; 
            padding-bottom: 5px; 
        }

        .profile__details p {
            font-family: 'Mulish', sans-serif;
            font-size: 16px;
            color: #666;
            margin-bottom: 20px;
        }

        .profile__details strong {
            color: purple;
        }

        .profile__pic {
            position: relative;
            display: inline-block;
            margin-right: 20px;
        }

        .profile__pic img {
            width: 200px;
            height: 200px;
            border-radius: 50%;
            object-fit: cover;
            border: 5px solid #fff;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
        }

        .profile__overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5); 
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .profile__overlay i {
            color: #fff;
            font-size: 32px;
            transition: transform 0.3s ease;
        }

        .profile__pic:hover .profile__overlay {
            opacity: 1; 
        }

        .profile__pic:hover .profile__overlay i {
            transform: scale(1.2); 
        }

        .saved-webtoons {
            padding: 60px 0;
        }

        .section-title h4 {
            font-size: 28px;
            color: #333;
            margin-bottom: 40px;
        }

        .product__item {
            width: 300px;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            transition: transform 0.3s ease;
        }

        .product__item:hover {
            transform: translateY(-10px);
        }

        .product__item__pic {
            position: relative;
            overflow: hidden;
        }

        .product__item__pic img {
            width: 100%;
            height: auto;
            transition: transform 0.3s ease;
        }

        .product__item__pic:hover img {
            transform: scale(1.1);
        }

        .product__item__text ul {
            display: flex;
            flex-wrap: wrap;
            padding: 0;
            margin: 10px 0;
        }

        .product__item__text ul li {
            margin-right: 10px;
            font-size: 14px;
            color: #666;
            background-color: #f5f5f5;
            padding: 5px 10px;
            border-radius: 20px;
        }

        .product__item__text h5 {
            font-size: 20px;
            color: #333;
            margin: 10px 0 0;
        }

        .product__item__text h5 a {
            color: #333;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .product__item__text h5 a:hover {
            color: purple;
        }

        .comment,
        .view {
            position: absolute;
            top: 10px;
            right: 10px;
            height: 20px; /* Yükseklik 20px */
            background: rgba(255, 255, 255, 0.8);
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 14px;
            color: #333;
        }
    </style>
</head>

<body>
    <!-- Profil Bölümü -->
    <section class="profile spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="profile__pic">
                        <img src="@Model.ProfilImage" alt="Profile Picture">
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="profile__details">
                        <h2>@Model.Username</h2>
                        <p><strong>Email:</strong> @Model.Email</p>
                        <p><strong>Biyografi:</strong> @Model.Biografi</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Kaydedilen Webtoonlar -->
    <section class="saved-webtoons spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <h4>Kaydedilen Webtoonlar</h4>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var webtoon in Model.SavedWebtoonsDetails)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="product__item">
                            <div class="product__item__pic set-bg" style="background-color: #f5f5f5; width: 300px; height: 450px;" data-setbg="@webtoon.CoverImage">
                                <div class="comment"><i class="fa fa-comments"></i> @webtoon.Likes</div>
                                <div class="view"><i class="fa fa-eye"></i> @webtoon.Saves</div>
                            </div>
                            <div class="product__item__text">
                                <ul>
                                    @foreach (var genre in webtoon.Genres)
                                    {
                                        <li>@genre</li>
                                    }
                                </ul>
                                <h5><a href="webtoon-details">@webtoon.Title</a></h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>



    <script src="js/jquery-3.3.1.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/player.js"></script>
    <script src="js/jquery.nice-select.min.js"></script>
    <script src="js/mixitup.min.js"></script>
    <script src="js/jquery.slicknav.js"></script>
    <script src="js/owl.carousel.min.js"></script>
    <script src="js/main.js"></script>
</body>
</html>
