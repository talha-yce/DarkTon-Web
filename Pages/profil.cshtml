@page
@model ProfileModel
@{
    ViewData["Title"] = "Profile Page";
}
<!DOCTYPE html>
<html lang="zxx">

<head>
    <meta charset="UTF-8">
    <meta name="description" content="Anime Template">
    <meta name="keywords" content="Anime, unica, creative, html">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Profil Sayfası</title>

    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Mulish:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="css/bootstrap.min.css" type="text/css">
    <link rel="stylesheet" href="css/font-awesome.min.css" type="text/css">
    <link rel="stylesheet" href="css/elegant-icons.css" type="text/css">
    <link rel="stylesheet" href="css/plyr.css" type="text/css">
    <link rel="stylesheet" href="css/nice-select.css" type="text/css">
    <link rel="stylesheet" href="css/owl.carousel.min.css" type="text/css">
    <link rel="stylesheet" href="css/slicknav.min.css" type="text/css">
    <link rel="stylesheet" href="css/style.css" type="text/css">
    <style>
        /* Özel CSS Buraya */
        .profile__pic img {
            width: 100%;
            border-radius: 50%;
            max-width: 200px;
        }

        .profile__details {
            padding-left: 20px;
        }

        .profile__details h2 {
            font-family: 'Oswald', sans-serif;
            font-size: 28px;
            color: #333;
            margin-bottom: 10px;
        }

        .profile__details p {
            font-family: 'Mulish', sans-serif;
            font-size: 16px;
            color: #666;
            margin-bottom: 10px;
        }

        .saved-webtoons .section-title h4 {
            font-family: 'Oswald', sans-serif;
            font-size: 24px;
            color: #333;
            margin-bottom: 20px;
        }

        .product__item {
            margin-bottom: 30px;
        }

        .product__item__pic {
            position: relative;
            overflow: hidden;
        }

        .product__item__pic img {
            width: 100%;
            height: auto;
            transition: transform 0.3s ease;
        }

        .product__item__pic:hover img {
            transform: scale(1.1);
        }

        .product__item__text ul {
            list-style-type: none;
            margin: 0;
            padding: 0;
            margin-bottom: 10px;
        }

        .product__item__text ul li {
            display: inline-block;
            margin-right: 10px;
            font-size: 14px;
            color: #666;
        }

        .product__item__text h5 {
            font-family: 'Oswald', sans-serif;
            font-size: 20px;
            color: #333;
            margin-top: 10px;
            margin-bottom: 0;
        }

        .product__item__text h5 a {
            color: #333;
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .product__item__text h5 a:hover {
            color: #ff0000;
        }

        .comment,
        .view {
            position: absolute;
            weight:20px;
            height: 20px;
            top: 10px;
            right: 10px;
            background: rgba(255, 255, 255, 0.8);
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 14px;
            color: #333;
        }
    </style>
</head>
<body>
    <div id="preloder">
        <div class="loader"></div>
    </div>

    <!-- Profil Bölümü -->
    <section class="profile spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <div class="profile__pic">
                        <img src="@Model.ProfilImage" alt="Profile Picture">
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="profile__details">
                        <h2>@Model.Username</h2>
                        <p><strong>Email:</strong> @Model.Email</p>
                        <p><strong>Biyografi:</strong> @Model.Biografi</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Kaydedilen Webtoonlar -->
    <section class="saved-webtoons spad">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section-title">
                        <h4>Kaydedilen Webtoonlar</h4>
                    </div>
                </div>
            </div>
            <div class="row">
                @foreach (var webtoonId in Model.SavedWebtoons)
                {
                    <div class="col-lg-4 col-md-6 col-sm-6">
                        <div class="product__item">
                            <div class="product__item__pic set-bg" style="background-image: url('img/anime/@(webtoonId).jpg');">
                                <div class="comment"><i class="fa fa-comments"></i> 11</div>
                                <div class="view"><i class="fa fa-eye"></i> 9141</div>
                            </div>
                            <div class="product__item__text">
                                <ul>
                                    <li>Romantik</li>
                                    <li>Komedi</li>
                                </ul>
                                <h5><a href="webtoon-details">@webtoonId</a></h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <script src="js/jquery-3.3.1.min.js"></script>
    <script src="js/bootstrap.min.js"></script>
    <script src="js/player.js"></script>
    <script src="js/jquery.nice-select.min.js"></script>
    <script src="js/mixitup.min.js"></script>
    <script src="js/jquery.slicknav.js"></script>
    <script src="js/owl.carousel.min.js"></script>
    <script src="js/main.js"></script>
</body>
</html>

